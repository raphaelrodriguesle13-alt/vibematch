# VibeMatch — placeholders APENAS. Nunca commite um .env com credenciais reais.
# Blueprint V1.2 §6.6: produção usa GCP Secret Manager, não arquivos .env.

NODE_ENV=development            # development | test | production

# --- PostgreSQL (local/test) -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vibematch
POSTGRES_OWNER_USER=vibematch_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Papéis de runtime (V1.2 §2.5). Senhas geradas localmente por scripts/db-roles.sh.
SVC_MATCHMAKING_PASSWORD=CHANGE_ME_LOCAL_ONLY
SVC_VIDEO_PASSWORD=CHANGE_ME_LOCAL_ONLY
SVC_MODERATION_PASSWORD=CHANGE_ME_LOCAL_ONLY
SVC_BILLING_PASSWORD=CHANGE_ME_LOCAL_ONLY
SVC_AUTH_PASSWORD=CHANGE_ME_LOCAL_ONLY
SVC_PROFILE_PASSWORD=CHANGE_ME_LOCAL_ONLY

DATABASE_URL_OWNER=postgres://vibematch_owner:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_MATCHMAKING=postgres://svc_matchmaking:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_VIDEO=postgres://svc_video:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_MODERATION=postgres://svc_moderation:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_BILLING=postgres://svc_billing:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_AUTH=postgres://svc_auth:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch
DATABASE_URL_PROFILE=postgres://svc_profile:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch

# node-pg-migrate lê esta variável
DATABASE_URL=postgres://vibematch_owner:CHANGE_ME_LOCAL_ONLY@localhost:5432/vibematch

# --- Configuração de domínio (V1.2 D2/D3) ------------------------------------
SESSION_INACTIVITY_TIMEOUT_SECONDS=60
CONSENT_VIDEO_DEADLINE_SECONDS=3600
CONSENT_DECISION_EXPIRY_SECONDS=86400

# --- Provedores externos ------------------------------------------------------
# Preenchidos via Secret Manager em produção. Nunca commitar valores reais.
SECRET_BACKEND=env                # env (local) | gcp-secret-manager (prod)
GCP_PROJECT_ID=
# RTC público consumido pelo Android; sem segredo e sempre wss:// em release.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# API administrativa somente backend; usada para operações como DeleteRoom.
LIVEKIT_API_URL=https://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGE_ASSURANCE_API_KEY=

# --- ChatGPT/OpenAI (somente backend; nunca expor no cliente) ------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_MS=30000
